# ==============================================================
# Frontend values (browser-visible; never place secrets here)
# ==============================================================
VITE_API_BASE_URL=http://localhost:3000

# SharePoint / OneDrive targets
VITE_SHAREPOINT_HOSTNAME=example.sharepoint.com
VITE_SHAREPOINT_SITE_PATH=/sites/approval-circulation
VITE_ONEDRIVE_DRIVE_ID=

# Shared-folder gateway (STEP 12)
VITE_SHARED_FOLDER_API_BASE_URL=

# ==============================================================
# Backend-only values for later steps
# Do not expose these values with a VITE_ prefix.
# Prefer certificate authentication over a long-lived client secret.
# ==============================================================
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_CERTIFICATE_PATH=
GRAPH_CLIENT_CERTIFICATE_THUMBPRINT=
NOTIFICATION_SENDER_ADDRESS=approval-circulation@example.com

# ==============================================================
# Frontend values (browser-visible; never place secrets here)
# ==============================================================
# "same-origin" uses the same company-PC address that served the Web app.
VITE_API_BASE_URL=same-origin
VITE_PUBLIC_BASE_PATH=/

# Optional separate address for the shared-folder gateway.
# Leave blank when the company-PC Web server also serves /api/shared-files.
VITE_SHARED_FOLDER_API_BASE_URL=

# ==============================================================
# Backend-only values
# Do not expose these values with a VITE_ prefix.
# Prefer certificate authentication over a long-lived client secret.
# ==============================================================
APP_HOST=127.0.0.1
APP_PORT=3000
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Semicolon-separated absolute folders that the app may read.
# Example: \\fileserver\ApprovalDocs;D:\ApprovalDocs
SHARED_FOLDER_ROOTS=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_CERTIFICATE_PATH=
GRAPH_CLIENT_CERTIFICATE_THUMBPRINT=
# Temporary fallback only. Prefer a certificate for production.
GRAPH_CLIENT_SECRET=
GRAPH_DIRECTORY_CACHE_TTL_MS=300000
GRAPH_DIRECTORY_MAX_USERS=5000

NOTIFICATION_SENDER_ADDRESS=approval-circulation@example.com
